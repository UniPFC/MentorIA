# Project
PROJECT_NAME=MentorIA
LOG_LEVEL=DEBUG

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database
POSTGRES_HOST=host
POSTGRES_PORT=port

# Vector DB (Qdrant)
QDRANT_HOST=vector_db
QDRANT_PORT=6333

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI/LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_API_KEY=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# Embedding & Reranking
EMBEDDING_PROVIDER=local              # "local" (HuggingFace) or "remote" (OpenAI-compatible API)
EMBEDDING_MODEL_ID=BAAI/bge-m3        # Model ID for local HuggingFace embedding
EMBEDDING_REMOTE_MODEL=text-embedding-3-small  # Model name for remote embedding API
EMBEDDING_REMOTE_PROVIDER=openai       # Provider alias for remote embedding (openai, ollama, etc.)
EMBEDDING_DIMENSION=1024
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3

# Speech-to-Text Configuration
STT_ENABLED=True                     # Enable/disable audio transcription feature
STT_MODEL=small                       # Model size: tiny, base, small, medium, large
STT_COMPUTE_TYPE=int8                # Compute type: int8, int16, float16, float32
STT_TIMEOUT=30                       # Seconds to wait for memory before failing

# RAG Parameters
K_RETRIEVAL=10
TOP_K=5
THRESHOLD=0.0

# System User
SYSTEM_USER_EMAIL=system@techstein.ai
SYSTEM_USER_PASSWORD=change-this-password

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Development Configs
DEV_MODE=False