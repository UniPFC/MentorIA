# Project
PROJECT_NAME=MentorIA
LOG_LEVEL=INFO

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=rag_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Vector DB (Qdrant)
QDRANT_HOST=vector_db
QDRANT_PORT=6333

# AI/LLM Provider API Keys
OLLAMA_API_KEY=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Embedding & Reranking Models
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_REMOTE_MODEL=text-embedding-3-small
EMBEDDING_REMOTE_PROVIDER=openai
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3

# Speech-to-Text Configuration
STT_ENABLED=True
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_TIMEOUT=30

# RAG Parameters
K_RETRIEVAL=10
TOP_K=5
THRESHOLD=0.0

# System User
SYSTEM_USER_EMAIL=system@techstein.ai
SYSTEM_USER_PASSWORD=change-this-password

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
PASSWORD_PEPPER=change-this-pepper
CSRF_SECRET_KEY=change-this-csrf-secret
ENCRYPTION_SALT=change-this-encryption-salt
BACKUP_PASSPHRASE=change-this-backup-passphrase
FORCE_HTTPS=False

# Development Configs
DEV_MODE=False
SKIP_PAYMENT=True
