################################################################################
# CONFIGURAÇÕES DO PROJETO
################################################################################

# PROJECT_NAME: Nome do projeto exibido em documentações e logs.
PROJECT_NAME=MentorIA

# LOG_LEVEL: Nível de verbosidade dos logs da aplicação.
# Opções comuns: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


################################################################################
# BANCO DE DADOS (POSTGRESQL)
################################################################################

# Credenciais e endereço para conexão com o banco relacional principal.
POSTGRES_USER=user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=rag_db
POSTGRES_HOST=db
POSTGRES_PORT=5432


################################################################################
# BANCO DE DADOS VETORIAL (QDRANT)
################################################################################

# Configuração para o motor de busca vetorial que armazena os embeddings (RAG).
QDRANT_HOST=vector_db
QDRANT_PORT=6333


################################################################################
# CHAVES DE API (PROVEDORES DE IA)
################################################################################

# Preencha de acordo com os provedores de modelos que deseja utilizar.
# Se estiver usando apenas Ollama localmente, basta deixar o OLLAMA_API_KEY preenchido.
OLLAMA_API_KEY=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=


################################################################################
# CONFIGURAÇÃO DE MODELOS LLM (GERAÇÃO DE TEXTO)
################################################################################

# LLM_PROVIDER: Provedor principal de chat. Opções: ollama, openai, gemini, etc.
LLM_PROVIDER=ollama

# LLM_MODEL: Nome do modelo que será usado como padrão no chat.
LLM_MODEL=llama3.2:3b


################################################################################
# EMBEDDINGS E RERANKING
################################################################################

# EMBEDDING_PROVIDER: Provedor para converter texto em vetores. Opções: local, openai
EMBEDDING_PROVIDER=local

# EMBEDDING_MODEL_ID: Modelo local (HuggingFace) para geração de embeddings.
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# EMBEDDING_REMOTE_MODEL: Modelo remoto para geração de embeddings (se provider=openai)
EMBEDDING_REMOTE_MODEL=text-embedding-3-small
EMBEDDING_REMOTE_PROVIDER=openai

# RERANKER_MODEL_ID: Modelo usado para re-rankear os resultados da busca vetorial
# com maior precisão semântica.
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3


################################################################################
# SPEECH-TO-TEXT (TRANSCRIÇÃO DE ÁUDIO)
################################################################################

# STT_ENABLED: Ativa ou desativa o suporte a mensagens de voz no chat.
STT_ENABLED=True

# STT_MODEL: Tamanho do modelo Whisper. Opções: tiny, base, small, medium, large
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_TIMEOUT=30


################################################################################
# PARÂMETROS DO RAG (RETRIEVAL-AUGMENTED GENERATION)
################################################################################

# K_RETRIEVAL: Quantidade inicial de fragmentos resgatados do banco vetorial.
K_RETRIEVAL=10

# TOP_K: Quantidade final de fragmentos enviados ao LLM após o Reranking.
TOP_K=5

# THRESHOLD: Pontuação mínima de similaridade para considerar um fragmento válido.
THRESHOLD=0.0


################################################################################
# CONFIGURAÇÃO ADMINISTRATIVA
################################################################################

# Credenciais criadas automaticamente pelo seeder para o painel de administração.
SYSTEM_USER_EMAIL=system@techstein.ai
SYSTEM_USER_PASSWORD=change-this-password
ADMIN_SLUG=admin-slug


################################################################################
# CONFIGURAÇÃO DE EMAIL (SMTP)
################################################################################

# Configurações para envio de e-mails de recuperação de senha e notificações.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com

# FRONTEND_URL: Usado para gerar links de recuperação de senha enviados por e-mail.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60


################################################################################
# CONFIGURAÇÃO JWT E SESSÕES
################################################################################

# SECRET_KEY: Chave principal usada para assinar os tokens de autenticação (JWT).
# Em produção, DEVE ter no mínimo 32 caracteres gerados aleatoriamente.
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# Tempo de vida dos tokens em minutos e dias.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


################################################################################
# SEGURANÇA GERAL DA APLICAÇÃO
################################################################################

# Chaves estáticas de segurança para processos criptográficos da API.
PASSWORD_PEPPER=change-this-pepper
ENCRYPTION_SALT=change-this-encryption-salt
BACKUP_PASSPHRASE=change-this-backup-passphrase


################################################################################
# CONFIGURAÇÕES DE DESENVOLVIMENTO E TESTE
################################################################################

# DEV_MODE: [True/False] 
# Se True, desliga certas defesas e ajusta comportamentos para facilitar
# testes locais na sua máquina. Não use True em produção!
DEV_MODE=False

# SKIP_PAYMENT: [True/False]
# Se True, você consegue assinar planos ou colocar saldo na sua conta 
# imediatamente pela interface sem passar pelo fluxo real do Pagar.me.
SKIP_PAYMENT=True


################################################################################
# FLAGS DE SEGURANÇA E COMPORTAMENTO (CONTROLE GRANULAR)
################################################################################

# SECURE_COOKIES: [True/False]
# Se True, os cookies de autenticação ganharão a flag 'Secure', o que significa
# que os navegadores SÓ aceitarão e enviarão esses cookies se a conexão for HTTPS.
# ATENÇÃO: Se estiver testando na sua máquina (http://localhost ou http://172.x.x.x), 
# coloque como 'False' ou você não conseguirá logar.
SECURE_COOKIES=True

# FORCE_HTTPS: [True/False]
# Se True, a API fará um redirecionamento automático (HTTP 301) para HTTPS 
# caso você tente acessá-la via HTTP puro, além de injetar cabeçalhos HSTS.
FORCE_HTTPS=False

# AUTO_RUN_SEEDER: [True/False]
# Se True, toda vez que o servidor iniciar, o backend rodará o seeder
# para injetar conhecimentos padrão no PostgreSQL e no Qdrant automaticamente.
# Coloque como False para o servidor subir mais rápido no dia a dia.
AUTO_RUN_SEEDER=True

# ENABLE_API_DOCS: [True/False]
# Se True, a documentação Swagger e ReDoc ficará acessível nos endpoints /docs
# e /redoc. Normalmente, deve ficar False em produção para evitar ataques.
ENABLE_API_DOCS=False
